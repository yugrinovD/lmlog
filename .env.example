# State database (inside the container in docker-compose)
LMLOG_DB=/state/lmlog.db

# Directory with log files
LMLOG_LOG_DIR=/data/logs

# Number of demo lines generated by the generator service
LMLOG_DEMO_LINES=200000

# Number of days to spread generated logs over
LMLOG_DEMO_DAYS=1

# Daemon interval in seconds
LMLOG_DAEMON_INTERVAL=300

# Optional HTTP API (`make serve`). Use a long random value, for example:
#   openssl rand -hex 32
LMLOG_API_TOKEN=
LMLOG_SERVE_PORT=8090
LMLOG_SERVE_MAX_UPLOAD_MB=50

# LLM mode: gateway (default) sends OpenAI-compatible requests to gogate.
# Use direct only for standalone development with the local `ai` profile.
LMLOG_LLM_MODE=direct
LMLOG_MODEL=qwen2.5:3b

# Gateway mode (full stack). The key is created by gogate admin API.
# GOGATE_BASE_URL=http://gogate:8080
# GOGATE_API_KEY=
# GOGATE_API_KEY_FILE=/run/secrets/gogate_api_key

# Direct mode (standalone development only)
OLLAMA_HOST=ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_PORT=11434
